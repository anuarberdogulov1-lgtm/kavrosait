<script>
(() => {
  'use strict';

  /* ===================================================================
     1. НАСТРОЙКИ (Валюта тенге KZT и защита)
     =================================================================== */
  const CONFIG = {
    BOT_URL: 'https://t.me/VYR0_bot?start=order',
    APPEND_ORDER_ID: true,
    OPEN_IN_NEW_TAB: true,
    ORDER_ENDPOINT: '',
    ADMIN_PASS: 'admin123', // Пароль по умолчанию

    currency: '₸',
    locale: 'ru-KZ',
    freeShippingFrom: 20000,   // порог бесплатной доставки в тенге

    contacts: {
      telegramChannel: 'https://t.me/kavroshop',
      telegramBot: 'https://t.me/VYR0_bot',
      telegramBotUsername: '@VYR0_bot',
      instagram: 'https://instagram.com/yourshop',
      email: 'hello@brandstore.example',
      phone: '+7 (000) 000-00-00',
      hours: 'Ежедневно, 10:00–20:00'
    }
  };

  /* ===================================================================
     2. ТОВАРЫ
     =================================================================== */
  const DEFAULT_PRODUCTS = [
    {
      id: 'fleece', cat: 'sneakers', image: 'fleece', pad: '2%',
      brand: 'Nordmark', name: 'Shearling Low', article: 'BS-0101', price: 98000, badge: 'Новинка',
      sizes: ['8', '9', '10', '11'], sizeUnit: 'US', sizeLabel: 'Размер, US',
      desc: 'Низкие кроссовки, целиком покрытые густым ворсом цвета горького шоколада. Плоская подошва в тон делает силуэт цельным. Хорошо смотрятся с прямым деним и плотным трикотажем.',
      specs: [['Материал', 'Плюшевый мех, текстильная подкладка'], ['Цвет', 'Шоколад'], ['Подошва', 'Плоская, в тон'], ['Артикул', 'BS-0101']],
      views: [{ z: 1, fx: .5, fy: .5 }, { z: 1.8, fx: .28, fy: .58 }]
    },
    {
      id: 'runner', cat: 'sneakers', image: 'runner', pad: '3%',
      brand: 'Atelier 09', name: 'Retro Runner Bronze', article: 'BS-0102', price: 115000, badge: 'Лимитированная серия',
      sizes: ['8', '9', '10', '11'], sizeUnit: 'US', sizeLabel: 'Размер, US',
      desc: 'Беговой силуэт в духе восьмидесятых из кожи с потёртой бронзово-чёрной патиной. Кремовые шнурки с крупным узлом, ремешок на пятке и рифлёная подошва заметны даже в тёмном образе.',
      specs: [['Материал', 'Кожа с эффектом патины'], ['Цвет', 'Бронза и чёрный'], ['Подошва', 'Рифлёная резина'], ['Артикул', 'BS-0102']],
      views: [{ z: 1, fx: .5, fy: .5 }, { z: 1.8, fx: .55, fy: .4 }]
    },
    {
      id: 'jeans', cat: 'clothes', image: 'jeans', pad: '5%',
      brand: 'Gris Studio', name: 'Washed Straight', article: 'BS-0201', price: 65000, badge: '',
      sizes: ['30', '32', '34', '36'], sizeUnit: 'W', sizeLabel: 'Размер, талия (W)',
      desc: 'Прямые джинсы из плотного денима серой варки. Выцветшие, будто запылённые колени и пуговичная застёжка делают их похожими на вещь, которую уже носили. Посадка на талии, прямая нога.',
      specs: [['Материал', 'Хлопковый деним'], ['Цвет', 'Серый, варёный'], ['Застёжка', 'Пуговицы'], ['Артикул', 'BS-0201']],
      views: [{ z: 1, fx: .5, fy: .5 }, { z: 2, fx: .34, fy: .5 }]
    },
    {
      id: 'bracelet', cat: 'accessories', image: 'bracelet', pad: '3%',
      brand: 'Argent & Co', name: 'Segment Bracelet', article: 'BS-0301', price: 52000, badge: 'Серебро 925',
      sizes: ['S', 'M', 'L'], sizeUnit: '', sizeLabel: 'Размер', sizeNote: 'S 17 см, M 19 см, L 21 см',
      desc: 'Браслет из серебра 925 пробы, собранный из гладких сегментов. Звенья плотно прилегают друг к другу и выглядят как цельная лента. Клипса с гравировкой пробы надёжно держит застёжку.',
      specs: [['Материал', 'Серебро 925'], ['Длина', 'S 17 см, M 19 см, L 21 см'], ['Застёжка', 'Клипса'], ['Артикул', 'BS-0301']],
      views: [{ z: 1, fx: .5, fy: .5 }, { z: 1.9, fx: .52, fy: .45 }]
    }
  ];

  const CATS = [
    { id: 'all', label: 'Все' },
    { id: 'sneakers', label: 'Кроссовки' },
    { id: 'clothes', label: 'Одежда' },
    { id: 'accessories', label: 'Аксессуары' }
  ];

  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
  const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const money = n => new Intl.NumberFormat(CONFIG.locale).format(n).replace(/\s/g, ' ') + ' ' + CONFIG.currency;
  const ico = (name, cls = '') => `<svg class="ico ${cls}"><use href="#i-${name}"/></svg>`;
  const lineKey = (id, size) => `${id}|${size}`;

  const store = {
    get(k, d) { try { const v = localStorage.getItem(k); return v ? JSON.parse(v) : d; } catch (e) { return d; } },
    set(k, v) { try { localStorage.setItem(k, JSON.stringify(v)); } catch (e) { } },
    remove(k) { try { localStorage.removeItem(k); } catch(e){} }
  };

  /* Состояние продуктов (загружается из localStorage) */
  const PRODUCTS_KEY = 'brandstore_products_v1';
  let PRODUCTS = store.get(PRODUCTS_KEY, DEFAULT_PRODUCTS);
  const saveProducts = () => store.set(PRODUCTS_KEY, PRODUCTS);

  const byId = id => PRODUCTS.find(p => p.id === id);
  const imgOf = p => (window.PRODUCT_IMAGES || {})[p.image] || p.image;
  const altOf = p => `${p.brand} ${p.name}`;
  const sizeText = (p, s) => (p.sizeUnit ? `${p.sizeUnit} ${s}` : s);

  /* Состояние приложения */
  const CART_KEY = 'brandstore_cart_v1';
  let cart = (store.get(CART_KEY, []) || []).filter(l => {
    const p = l && byId(l.id);
    return p && p.sizes.includes(l.size) && l.qty > 0 && l.qty < 10;
  });
  const selected = {};
  let filter = 'all';
  let sortMode = 'default';
  let step = 'cart';
  let modalState = null;
  let isAdminAuthed = store.get('brandstore_admin_auth', false);

  const saveCart = () => store.set(CART_KEY, cart);

  /* ===================================================================
     КАТАЛОГ
     =================================================================== */
  const grid = $('#grid');

  function renderFilters() {
    const count = id => PRODUCTS.filter(p => id === 'all' || p.cat === id).length;
    $('#filters').innerHTML = CATS.filter(c => c.id === 'all' || count(c.id) > 0).map(c =>
      `<button type="button" class="filter" data-f="${c.id}" aria-pressed="${filter === c.id}">${c.label}<sup>${count(c.id)}</sup></button>`
    ).join('');
  }

  const chipHTML = (p, s, on) =>
    `<button type="button" class="chip" role="radio" aria-checked="${on}" data-size="${esc(s)}"${(p.soldOut || []).includes(s) ? ' disabled' : ''}>${esc(s)}</button>`;

  function cardHTML(p, i) {
    const chips = p.sizes.map(s => chipHTML(p, s, selected[p.id] === s)).join('');
    return `
    <article class="card" style="--i:${i}" data-id="${p.id}">
      <button type="button" class="card-media" data-open="${p.id}" style="--pad:${p.pad || '6%'}" aria-label="Открыть: ${esc(p.name)}">
        <img class="pimg fit" src="${esc(imgOf(p))}" alt="${esc(altOf(p))}" loading="lazy" draggable="false">
        ${p.badge ? `<span class="badge">${esc(p.badge)}</span>` : ''}
        <span class="qv">Быстрый просмотр</span>
      </button>
      <div class="card-body">
        <div class="card-head">
          <h3 class="name"><button type="button" data-open="${p.id}">${esc(p.name)}</button></h3>
          <p class="price">${money(p.price)}</p>
        </div>
        <p class="brand">${esc(p.brand)}</p>
        <div class="size-row" data-size-row>
          <span class="size-label" data-size-label>${esc(p.sizeLabel || 'Размер')}</span>
          <div class="chips" role="radiogroup" aria-label="${esc(p.sizeLabel || 'Размер')}">${chips}</div>
        </div>
        <button type="button" class="btn" data-add="${p.id}">В корзину</button>
      </div>
    </article>`;
  }

  function renderGrid() {
    let list = PRODUCTS.filter(p => filter === 'all' || p.cat === filter);
    if (sortMode === 'asc') list = list.slice().sort((a, b) => a.price - b.price);
    if (sortMode === 'desc') list = list.slice().sort((a, b) => b.price - a.price);
    grid.innerHTML = list.length ? list.map(cardHTML).join('') : '<p class="empty">В этой категории пока нет товаров.</p>';
    $('#gridStatus').textContent = `Показано товаров: ${list.length}`;
  }

  function flagSize(row) {
    row.classList.remove('err'); void row.offsetWidth; row.classList.add('err');
    $('[data-size-label]', row).textContent = 'Выберите размер';
  }
  function clearFlag(row, p) {
    row.classList.remove('err');
    $('[data-size-label]', row).textContent = p.sizeLabel || 'Размер';
  }

  function setSelected(id, size) {
    selected[id] = size;
    const card = $(`.card[data-id="${id}"]`);
    if (card) {
      $$('.chip', card).forEach(c => c.setAttribute('aria-checked', c.dataset.size === size));
      clearFlag($('[data-size-row]', card), byId(id));
    }
  }

  $('#filters').addEventListener('click', e => {
    const b = e.target.closest('[data-f]'); if (!b) return;
    filter = b.dataset.f; renderFilters(); renderGrid();
  });
  $('#sort').addEventListener('change', e => { sortMode = e.target.value; renderGrid(); });

  grid.addEventListener('click', e => {
    const open = e.target.closest('[data-open]');
    if (open) { openModal(open.dataset.open); return; }

    const chip = e.target.closest('.chip');
    if (chip) { setSelected(chip.closest('.card').dataset.id, chip.dataset.size); return; }

    const add = e.target.closest('[data-add]');
    if (add) {
      const p = byId(add.dataset.add), size = selected[p.id];
      if (!size) { flagSize($('[data-size-row]', add.closest('.card')), p); return; }
      addToCart(p.id, size, true);
    }
  });

  /* ===================================================================
     КОРЗИНА
     =================================================================== */
  const cartLines = () => cart.map(l => ({ ...l, p: byId(l.id) })).filter(l => l.p);
  const subtotal = () => cartLines().reduce((s, l) => s + l.p.price * l.qty, 0);
  const totalQty = () => cart.reduce((s, l) => s + l.qty, 0);

  function addToCart(id, size, withToast) {
    const line = cart.find(l => l.id === id && l.size === size);
    if (line) line.qty = Math.min(line.qty + 1, 9); else cart.push({ id, size, qty: 1 });
    saveCart(); updateBadge(true); renderCart();
    if (withToast) { const p = byId(id); toast(`Добавлено в корзину: ${p.name}, ${sizeText(p, size)}`); }
  }

  function updateBadge(bump) {
    const n = totalQty(), el = $('#cartCount');
    el.textContent = n;
    el.classList.toggle('zero', n === 0);
    $('#cartBtn').setAttribute('aria-label', `Корзина, товаров: ${n}`);
    if (bump) { el.classList.remove('bump'); void el.offsetWidth; el.classList.add('bump'); }
  }

  function itemHTML(l) {
    const k = esc(lineKey(l.id, l.size)), p = l.p;
    return `
    <div class="ci" data-k="${k}">
      <div class="ci-thumb" style="--pad:${p.pad || '6%'}"><img class="pimg fit" src="${esc(imgOf(p))}" alt="" draggable="false"></div>
      <div>
        <p class="ci-name">${esc(p.name)}</p>
        <p class="ci-meta">${esc(p.brand)}</p>
        <p class="ci-meta">Размер: ${esc(sizeText(p, l.size))}</p>
      </div>
      <p class="ci-price">${money(p.price * l.qty)}</p>
      <div class="ci-row">
        <div class="qty">
          <button type="button" data-act="dec" data-k="${k}" aria-label="Уменьшить количество">${ico('minus')}</button>
          <output aria-label="Количество">${l.qty}</output>
          <button type="button" data-act="inc" data-k="${k}" aria-label="Увеличить количество">${ico('plus')}</button>
        </div>
        <button type="button" class="ci-rm" data-act="rm" data-k="${k}">Удалить</button>
      </div>
    </div>`;
  }

  function renderCart() {
    const lines = cartLines(), body = $('#cartBody'), foot = $('#cartFoot');
    if (!lines.length) {
      body.innerHTML = `<div class="d-empty"><p>В корзине пока пусто</p><button class="btn btn--ghost" type="button" data-go-catalog>Перейти в каталог</button></div>`;
      foot.hidden = true; return;
    }
    foot.hidden = false;
    const sub = subtotal(), left = CONFIG.freeShippingFrom - sub, pct = Math.min(100, sub / CONFIG.freeShippingFrom * 100);
    body.innerHTML =
      `<div class="ship-note">${left > 0 ? `До бесплатной доставки ещё ${money(left)}` : 'Доставка бесплатная'}<div class="ship-bar" style="--p:${pct}%"><i></i></div></div>` +
      lines.map(itemHTML).join('');
    foot.innerHTML = `
      <div class="sum">
        <div><span>Товары</span><span>${money(sub)}</span></div>
        <div><span>Доставка</span><span>${left > 0 ? 'Рассчитаем в боте' : 'Бесплатно'}</span></div>
        <div class="total"><span>Итого</span><span>${money(sub)}</span></div>
      </div>
      <button class="btn btn--block" type="button" data-checkout>Оплатить заказ ${ico('arrow')}</button>`;
  }

  $('#cartBody').addEventListener('click', e => {
    if (e.target.closest('[data-go-catalog]')) { closeLayer(); location.hash = '#catalog'; return; }
    const b = e.target.closest('[data-act]'); if (!b) return;
    const [id, size] = b.dataset.k.split('|');
    const line = cart.find(l => l.id === id && l.size === size); if (!line) return;
    const act = b.dataset.act;
    if (act === 'inc') line.qty = Math.min(line.qty + 1, 9);
    if (act === 'dec') line.qty = Math.max(line.qty - 1, 1);
    if (act === 'rm') cart = cart.filter(l => l !== line);
    saveCart(); updateBadge(); renderCart();
    const again = act !== 'rm' && $(`[data-act="${act}"][data-k="${CSS.escape(b.dataset.k)}"]`);
    if (again) again.focus();
  });
  $('#cartFoot').addEventListener('click', e => { if (e.target.closest('[data-checkout]')) goToForm(); });
  $('#cartBtn').addEventListener('click', openCart);

  /* ===================================================================
     ОКНО ТОВАРА
     =================================================================== */
  const PAD = 0.06;

  function applyZoom(img) {
    const z = parseFloat(img.dataset.z) || 1;
    if (z === 1) { img.style.transform = ''; return; }
    const box = img.parentElement, W = box.clientWidth, H = box.clientHeight;
    const nw = img.naturalWidth, nh = img.naturalHeight;
    if (!W || !H || !nw) return;
    const pad = PAD * W, aw = W - 2 * pad, ah = H - 2 * pad;
    const s = Math.min(aw / nw, ah / nh), pw = nw * s, ph = nh * s;
    const ox = (W - pw) / 2 + pw * parseFloat(img.dataset.fx);
    const oy = (H - ph) / 2 + ph * parseFloat(img.dataset.fy);
    img.style.transformOrigin = `${ox}px ${oy}px`;
    img.style.transform = `scale(${z})`;
  }
  const layoutZoom = () => $$('#mBody img[data-z]').forEach(applyZoom);

  function viewsOf(p) {
    return p.images
      ? p.images.map(src => ({ src, z: 1, fx: .5, fy: .5 }))
      : (p.views || [{ z: 1, fx: .5, fy: .5 }]).map(v => ({ src: imgOf(p), ...v }));
  }

  function modalHTML(p, size) {
    const views = viewsOf(p);
    const dataAttrs = v => `data-z="${v.z}" data-fx="${v.fx}" data-fy="${v.fy}"`;
    const slides = views.map((v, i) => `
      <figure class="m-slide${i ? '' : ' on'}" data-slide="${i}">
        <img class="pimg" src="${esc(v.src)}" alt="${esc(i ? 'Крупный план: ' + p.name : altOf(p))}" ${dataAttrs(v)} draggable="false">
      </figure>`).join('');
    const thumbs = views.map((v, i) => `
      <button type="button" class="m-thumb${i ? '' : ' on'}" data-thumb="${i}" aria-label="Фото ${i + 1}">
        <img class="pimg" src="${esc(v.src)}" alt="" ${dataAttrs(v)} draggable="false">
      </button>`).join('');
    const arrows = views.length > 1
      ? `<button type="button" class="icon-btn m-arrow prev" data-g="-1" aria-label="Предыдущее фото">${ico('chev-l')}</button>
         <button type="button" class="icon-btn m-arrow next" data-g="1" aria-label="Следующее фото">${ico('chev-r')}</button>` : '';
    const chips = p.sizes.map(s => chipHTML(p, s, size === s)).join('');
    return `
    <div class="m-gal">
      <div class="m-stage">${slides}${arrows}</div>
      ${views.length > 1 ? `<div class="m-thumbs">${thumbs}</div>` : ''}
    </div>
    <div class="m-info">
      <p class="m-brand"><span>${esc(p.brand)}</span><span>Арт. ${esc(p.article)}</span></p>
      <h2 class="m-title" id="mTitle">${esc(p.name)}</h2>
      <p class="m-price">${money(p.price)}</p>
      <p class="m-desc">${esc(p.desc)}</p>
      <div data-size-row>
        <div class="m-size-head"><span class="size-label" data-size-label>${esc(p.sizeLabel || 'Размер')}</span>${p.sizeNote ? `<span class="m-size-note">${esc(p.sizeNote)}</span>` : ''}</div>
        <div class="chips" role="radiogroup" aria-label="${esc(p.sizeLabel || 'Размер')}">${chips}</div>
      </div>
      <button type="button" class="btn btn--block" data-m-add>В корзину ${ico('arrow')}</button>
      <dl class="specs">${(p.specs || []).map(([k, v]) => `<div><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>`).join('')}</dl>
      <ul class="m-perks">
        <li>${ico('truck')}Срок доставки от 4 до 9 дней (Казпочта)</li>
        <li>${ico('send')}Оплата в Telegram-боте</li>
      </ul>
    </div>`;
  }

  function setSlide(i) {
    const n = $$('.m-slide').length; if (!n) return;
    modalState.slide = (i + n) % n;
    $$('.m-slide').forEach((s, k) => s.classList.toggle('on', k === modalState.slide));
    $$('.m-thumb').forEach((t, k) => { t.classList.toggle('on', k === modalState.slide); t.toggleAttribute('aria-current', k === modalState.slide); });
  }

  function openModal(id) {
    const p = byId(id); if (!p) return;
    modalState = { p, slide: 0 };
    $('#mBody').innerHTML = modalHTML(p, selected[id]);
    $$('#mBody img[data-z]').forEach(img => img.addEventListener('load', () => applyZoom(img)));
    $('.m-dialog').scrollTop = 0;
    openLayer('modal');
    requestAnimationFrame(layoutZoom);
  }

  $('#mBody').addEventListener('click', e => {
    const p = modalState && modalState.p; if (!p) return;
    const g = e.target.closest('[data-g]'); if (g) { setSlide(modalState.slide + Number(g.dataset.g)); return; }
    const t = e.target.closest('[data-thumb]'); if (t) { setSlide(Number(t.dataset.thumb)); return; }
    const chip = e.target.closest('.chip');
    if (chip) {
      setSelected(p.id, chip.dataset.size);
      $$('#mBody .chip').forEach(c => c.setAttribute('aria-checked', c === chip));
      clearFlag($('#mBody [data-size-row]'), p);
      return;
    }
    if (e.target.closest('[data-m-add]')) {
      if (!selected[p.id]) { flagSize($('#mBody [data-size-row]'), p); return; }
      addToCart(p.id, selected[p.id], false);
      openCart();
    }
  });
  $('#mClose').addEventListener('click', () => closeLayer());

  /* ===================================================================
     АДМИН-ПАНЕЛЬ И АВТОРИЗАЦИЯ
     =================================================================== */
  function renderAdminProductList() {
    const list = $('#adminProductList');
    list.innerHTML = PRODUCTS.map(p => `
      <div class="admin-item">
        <div class="admin-item-info">
          <img class="admin-item-img" src="${esc(imgOf(p))}" alt="">
          <div>
            <b style="font-size:14px; color:var(--espresso);">${esc(p.brand)} — ${esc(p.name)}</b>
            <div style="font-size:13px; color:var(--mute);">${money(p.price)} | Арт: ${esc(p.article)}</div>
          </div>
        </div>
        <button type="button" class="btn btn--danger btn--sm" data-delete="${esc(p.id)}">Удалить</button>
      </div>
    `).join('');
  }

  function openAdmin() {
    if (!isAdminAuthed) {
      $('#adminPass').value = '';
      $('#loginField').classList.remove('err');
      openLayer('loginModal');
      setTimeout(() => $('#adminPass').focus(), 50);
      return;
    }
    renderAdminProductList();
    openLayer('adminModal');
  }

  $('#openAdminTrigger').addEventListener('click', openAdmin);
  $('#adminClose').addEventListener('click', () => closeLayer());
  $('#loginClose').addEventListener('click', () => closeLayer());

  $('#loginForm').addEventListener('submit', e => {
    e.preventDefault();
    const pass = $('#adminPass').value;
    if (pass === CONFIG.ADMIN_PASS) {
      isAdminAuthed = true;
      store.set('brandstore_admin_auth', true);
      closeLayer(true);
      openAdmin();
    } else {
      $('#loginField').classList.add('err');
    }
  });

  $('#adminLogout').addEventListener('click', () => {
    isAdminAuthed = false;
    store.remove('brandstore_admin_auth');
    closeLayer();
    toast('Вы вышли из админ-панели');
  });

  $('#adminProductList').addEventListener('click', e => {
    const btn = e.target.closest('[data-delete]');
    if (!btn) return;
    const id = btn.dataset.delete;
    if (confirm('Вы уверены, что хотите удалить этот товар?')) {
      PRODUCTS = PRODUCTS.filter(p => p.id !== id);
      cart = cart.filter(l => l.id !== id);
      saveProducts();
      saveCart();
      renderFilters();
      renderGrid();
      renderCart();
      updateBadge();
      renderAdminProductList();
      toast('Товар удален');
    }
  });

  $('#adminForm').addEventListener('submit', e => {
    e.preventDefault();
    const name = $('#admName').value.trim();
    const brand = $('#admBrand').value.trim();
    const cat = $('#admCat').value;
    const price = Number($('#admPrice').value);
    const article = $('#admArticle').value.trim();
    const badge = $('#admBadge').value.trim();
    const image = $('#admImage').value.trim();
    const sizes = $('#admSizes').value.split(',').map(s => s.trim()).filter(Boolean);
    const sizeUnit = $('#admSizeUnit').value.trim();
    const sizeLabel = $('#admSizeLabel').value.trim() || 'Размер';
    const desc = $('#admDesc').value.trim();
    const rawSpecs = $('#admSpecs').value.trim().split('\n').filter(Boolean);

    const specs = rawSpecs.map(line => {
      const pts = line.split(':');
      return [pts[0] ? pts[0].trim() : '', pts[1] ? pts[1].trim() : ''];
    });

    const newProd = {
      id: 'custom_' + Date.now().toString(36),
      cat,
      image,
      pad: '5%',
      brand,
      name,
      article,
      price,
      badge,
      sizes,
      sizeUnit,
      sizeLabel,
      desc,
      specs
    };

    PRODUCTS.push(newProd);
    saveProducts();
    renderFilters();
    renderGrid();
    renderAdminProductList();
    $('#adminForm').reset();
    toast('Новый товар добавлен в каталог');
  });

  /* ===================================================================
     СЛОИ И УПРАВЛЕНИЕ
     =================================================================== */
  const scrim = $('#scrim');
  const LAYERS = { modal: $('#modal'), drawer: $('#drawer'), menu: $('#mnav'), adminModal: $('#adminModal'), loginModal: $('#loginModal') };
  let current = null, returnFocus = null;

  function openLayer(name) {
    if (current === name) return;
    if (current) closeLayer(true);
    returnFocus = document.activeElement;
    current = name;
    $('#toast').classList.remove('on');
    LAYERS[name].classList.add('on');
    if (name !== 'menu') scrim.classList.add('on');
    document.documentElement.classList.add('lock');
    if (name === 'menu') { $('#burger').setAttribute('aria-expanded', 'true'); $('#burger').setAttribute('aria-label', 'Закрыть меню'); }
    setTimeout(() => {
      const f = name === 'drawer' ? ($('#stepForm:not([hidden]) #fName') || $('#dClose')) : name === 'modal' ? $('#mClose') : name === 'adminModal' ? $('#adminClose') : name === 'loginModal' ? $('#adminPass') : null;
      if (f) f.focus({ preventScroll: true });
    }, 40);
  }

  function closeLayer(silent) {
    if (!current) return;
    const name = current; current = null;
    LAYERS[name].classList.remove('on');
    scrim.classList.remove('on');
    document.documentElement.classList.remove('lock');
    if (name === 'menu') { $('#burger').setAttribute('aria-expanded', 'false'); $('#burger').setAttribute('aria-label', 'Открыть меню'); }
    if (name === 'drawer' && step === 'done') setStep('cart');
    if (!silent && returnFocus && document.contains(returnFocus)) returnFocus.focus({ preventScroll: true });
  }

  scrim.addEventListener('click', () => closeLayer());
  $('#dClose').addEventListener('click', () => closeLayer());
  $('#burger').addEventListener('click', () => (current === 'menu' ? closeLayer() : openLayer('menu')));
  $('#mnav').addEventListener('click', e => { if (e.target.closest('a')) closeLayer(true); });

  document.addEventListener('keydown', e => {
    if (!current) return;
    if (e.key === 'Escape') { closeLayer(); return; }
    if (current === 'modal' && (e.key === 'ArrowLeft' || e.key === 'ArrowRight') && !/INPUT|TEXTAREA|SELECT/.test(e.target.tagName)) {
      setSlide(modalState.slide + (e.key === 'ArrowRight' ? 1 : -1)); return;
    }
    if (e.key === 'Tab' && current !== 'menu') {
      const items = $$('a[href],button:not([disabled]),input,select,textarea', LAYERS[current]).filter(el => el.offsetParent !== null);
      if (!items.length) return;
      const first = items[0], last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  /* ===================================================================
     КОРЗИНА: ШАГИ
     =================================================================== */
  function setStep(s) {
    step = s;
    $('#stepCart').hidden = s !== 'cart';
    $('#stepForm').hidden = s !== 'form';
    $('#stepDone').hidden = s !== 'done';
    $('#dTitle').textContent = { cart: 'Корзина', form: 'Контакты', done: 'Заказ оформлен' }[s];
    $$('#drawer .d-body').forEach(b => { b.scrollTop = 0; });
  }

  function openCart() { setStep('cart'); renderCart(); openLayer('drawer'); }

  function goToForm() {
    if (!cart.length) return;
    const lines = cartLines();
    $('#miniSum').innerHTML =
      lines.map(l => `<div><span>${esc(l.p.name)}, ${esc(sizeText(l.p, l.size))} × ${l.qty}</span><span>${money(l.p.price * l.qty)}</span></div>`).join('') +
      `<div><span>Итого</span><span>${money(subtotal())}</span></div>`;
    setStep('form');
    setTimeout(() => $('#fName').focus({ preventScroll: true }), 40);
  }
  $('#backToCart').addEventListener('click', () => { setStep('cart'); });

  /* ===================================================================
     ОФОРМЛЕНИЕ ЗАКАЗА
     =================================================================== */
  const makeOrderId = () => 'BS-' + (Date.now().toString(36).slice(-4) + Math.random().toString(36).slice(2, 4)).toUpperCase();

  function botUrl(orderId) {
    try {
      const u = new URL(CONFIG.BOT_URL);
      if (CONFIG.APPEND_ORDER_ID) u.searchParams.set('start', `${u.searchParams.get('start') || 'order'}_${orderId}`.slice(0, 64));
      return u.toString();
    } catch (e) { return CONFIG.BOT_URL; }
  }

  function orderText(o) {
    const lines = [
      `Заказ ${o.id}`,
      `Имя: ${o.customer.name}`,
      `Контакт: ${o.customer.contact}`,
      '',
      ...o.items.map((i, n) => `${n + 1}. ${i.brand} ${i.name} (${i.article}), ${i.size} × ${i.qty}: ${money(i.price * i.qty)}`),
      '',
      `Итого: ${money(o.total)}`
    ];
    if (o.customer.comment) lines.push(`Комментарий: ${o.customer.comment}`);
    return lines.join('\n');
  }

  async function copyText(text) {
    try { await navigator.clipboard.writeText(text); return true; } catch (e) { }
    try {
      const ta = document.createElement('textarea');
      ta.value = text; ta.setAttribute('readonly', ''); ta.style.cssText = 'position:fixed;top:0;opacity:0';
      document.body.appendChild(ta); ta.select();
      const ok = document.execCommand('copy'); ta.remove(); return ok;
    } catch (e) { return false; }
  }

  function setFieldError(groupId, message) {
    const g = $('#' + groupId);
    g.classList.toggle('err', !!message);
    if (message) $('.msg', g).textContent = message;
    return !message;
  }

  function validateForm() {
    const name = $('#fName').value.trim(), contact = $('#fContact').value.trim();
    const digits = contact.replace(/\D/g, '');
    const isTg = /^@?[A-Za-z][A-Za-z0-9_]{4,31}$/.test(contact);
    const isPhone = /^[+\d][\d\s().-]*$/.test(contact) && digits.length >= 10 && digits.length <= 15;
    const okName = setFieldError('fgName', name.length >= 2 ? '' : 'Укажите имя, чтобы мы знали, как к вам обращаться.');
    const okContact = setFieldError('fgContact', isTg || isPhone ? '' : 'Укажите Telegram в формате @username или номер телефона.');
    if (!okName) $('#fName').focus(); else if (!okContact) $('#fContact').focus();
    return okName && okContact;
  }

  $('#stepForm').addEventListener('input', e => {
    if (e.target.id === 'fName') setFieldError('fgName', '');
    if (e.target.id === 'fContact') setFieldError('fgContact', '');
  });

  $('#stepForm').addEventListener('submit', e => {
    e.preventDefault();
    if (!validateForm() || !cart.length) return;

    const order = {
      id: makeOrderId(),
      createdAt: new Date().toISOString(),
      customer: { name: $('#fName').value.trim(), contact: $('#fContact').value.trim(), comment: $('#fComment').value.trim() },
      items: cartLines().map(l => ({ id: l.id, article: l.p.article, brand: l.p.brand, name: l.p.name, size: sizeText(l.p, l.size), qty: l.qty, price: l.p.price })),
      total: subtotal()
    };
    const url = botUrl(order.id), text = orderText(order);
    store.set('brandstore_last_order', order);

    if (CONFIG.ORDER_ENDPOINT) {
      try { fetch(CONFIG.ORDER_ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(order), keepalive: true }).catch(() => {}); } catch (err) { }
    }

    const copied = copyText(text);
    cart = []; saveCart(); updateBadge(); renderCart();
    showDone(order, url, text, copied);

    if (CONFIG.OPEN_IN_NEW_TAB) {
      const w = window.open(url, '_blank');
      if (w) { try { w.opener = null; } catch (err) { } }
      else if (window.self === window.top) location.href = url;
    } else if (window.self === window.top) {
      location.href = url;
    }
  });

  function showDone(order, url, text, copiedPromise) {
    $('#doneBody').innerHTML = `
      <div class="done">
        <div class="slip">
          <p class="slip-no">Заказ ${esc(order.id)}</p>
          <h3>Заказ оформлен</h3>
          <ul>${order.items.map(i => `<li><span>${esc(i.name)}, ${esc(i.size)} × ${i.qty}</span><span>${money(i.price * i.qty)}</span></li>`).join('')}</ul>
          <div class="slip-total"><span>Итого</span><span>${money(order.total)}</span></div>
        </div>
        <p class="fine">Открываем Telegram-бот для оплаты. Если он не открылся, нажмите кнопку ниже.</p>
        <a class="btn btn--block" href="${esc(url)}" target="_blank" rel="noopener">Открыть Telegram-бот ${ico('arrow')}</a>
        <button class="btn btn--ghost btn--block" type="button" id="copyOrder">Скопировать состав заказа</button>
        <p class="copy-state" id="copyState" role="status"></p>
        <button class="link" type="button" data-go-catalog>Вернуться в каталог</button>
      </div>`;
    copiedPromise.then(ok => { if (ok && $('#copyState')) $('#copyState').textContent = 'Состав заказа скопирован. Вставьте его в чат с ботом.'; });
    $('#copyOrder').addEventListener('click', async () => {
      const ok = await copyText(text);
      $('#copyState').textContent = ok ? 'Скопировано. Вставьте состав заказа в чат с ботом.' : 'Не удалось скопировать. Выделите состав заказа выше и скопируйте вручную.';
    });
    $('#stepForm').reset();
    setStep('done');
  }
  $('#doneBody').addEventListener('click', e => { if (e.target.closest('[data-go-catalog]')) { closeLayer(); location.hash = '#catalog'; } });

  /* ===================================================================
     ТОСТ
     =================================================================== */
  let toastTimer;
  function toast(msg) {
    $('#toastText').textContent = msg;
    $('#toast').classList.add('on');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => $('#toast').classList.remove('on'), 3800);
  }
  $('#toastBtn').addEventListener('click', () => { $('#toast').classList.remove('on'); openCart(); });

  /* ===================================================================
     ИНИЦИАЛИЗАЦИЯ
     =================================================================== */
  function init() {
    $$('img[data-img]').forEach(img => { img.src = imgOf({ image: img.dataset.img }); });

    const c = CONFIG.contacts;
    $$('[data-link]').forEach(a => {
      const t = a.dataset.link;
      a.href = t === 'email' ? `mailto:${c.email}` : t === 'phone' ? `tel:${c.phone.replace(/[^\d+]/g, '')}` : c[t];
    });
    $$('[data-text]').forEach(el => {
      const t = el.dataset.text;
      el.textContent = t === 'telegram' ? c.telegramBotUsername : c[t];
    });
    $$('[data-free]').forEach(el => { el.textContent = money(CONFIG.freeShippingFrom); });
    $('#year').textContent = new Date().getFullYear();

    const hero = byId('runner');
    if (hero) {
      $('#tagBrand').textContent = hero.brand;
      $('#tagName').textContent = hero.name;
      $('#tagSize').textContent = `${hero.sizeUnit} ${hero.sizes[0]}–${hero.sizes[hero.sizes.length - 1]}`;
      $('#tagPrice').textContent = money(hero.price);
      $('#heroTag').addEventListener('click', () => openModal(hero.id));
    }

    renderFilters(); renderGrid(); renderCart(); updateBadge();

    const onScroll = () => $('#hdr').classList.toggle('stuck', window.scrollY > 8);
    window.addEventListener('scroll', onScroll, { passive: true }); onScroll();

    let rt; window.addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(layoutZoom, 120); });
  }

  document.addEventListener('DOMContentLoaded', init);
})();
</script>
<script>
window.PRODUCT_IMAGES = {
  fleece: 'data:image/jpeg;base64, '
};
</script>
